/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], inc, load, reset;
    OUT out[16];
    
    PARTS:
    Inc16(in=prevCount, out=incCount);

    Mux16(a=prevCount, b=incCount, sel=inc, out=incOrPass);
    Mux16(a=incOrPass, b=in, sel=load, out=loadOrPass);
    Mux16(a=loadOrPass, b=false, sel=reset, out=zeroOrPass);

    Register(in=zeroOrPass, load=true, out=prevCount, out=out);
}
